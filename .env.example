# Authentication mode.
# Use "mock" for local frontend development without Microsoft Entra.
# Use "entra" for real Microsoft Entra authentication.
VITE_AUTH_MODE=mock
VITE_USE_MOCK_ME=false

# Microsoft Entra SPA app registration client ID
VITE_ENTRA_CLIENT_ID=

# Microsoft Entra tenant ID
VITE_ENTRA_TENANT_ID=

# Must exactly match the redirect URI configured in the Entra app registration
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# Optional for now. Example later:
# api://<backend-api-client-id>/access_as_user
VITE_API_SCOPE=